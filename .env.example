# ── Jarvis-Mobile Configuration ───────────────────────────
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model to use (options: gemini-2.5-flash, gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Server settings for Mobile Web HUD
HOST=0.0.0.0
PORT=8000

# Device Automation Settings
# Set to 'true' to simulate Termux/ADB if running on PC or without Termux:API
SIMULATION_MODE=false

# Wireless ADB IP and port (e.g. 127.0.0.1:5555 or empty if connected locally via termux adb)
ADB_TARGET=
